# .env.example — bu faylni `.env` deb nusxalang va haqiqiy qiymatlarni yozing.
# `.env` git'ga TUSHMAYDI (.gitignore da), shuning uchun parollar shu yerda qoladi.

# ─────────────────────────── BAZA ───────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chem_scada
DB_USER=postgres
DB_PASSWORD=

# ─────────────────────────── MODELLAR ───────────────────────
# "ollama" yoki "vllm"
LLM_PROVIDER=ollama

# Model serverining manzili (ngrok bo'lsa ham shu yerga)
OLLAMA_BASE_URL=http://localhost:11434

# vLLM ishlatilsa — API kaliti. Ollama uchun bo'sh qoldiring.
VLLM_API_KEY=
VLLM_JSON_MODE=true

OLLAMA_TEXT_MODEL=qwen3:14b
VISION_MODEL=qwen3-vl:8b

# ─────────────────────────── SCADA ──────────────────────────
# Kadr qayerdan olinadi:
#   url    — veb-dashboard (SCADA_URL), brauzerda ochiladi
#   camera — boshqa monitordagi dashboard kamera orqali
#   window — shu kompyuterdagi SCADA dasturi oynasi
#   screen — shu kompyuterning butun ekrani
CAPTURE_MODE=url

# Kuzatiladigan dashboard manzili (CAPTURE_MODE=url). Boshqa SCADA'ga
# o'tishda ODATDA FAQAT SHU QATORNI o'zgartirish kifoya.
SCADA_URL=

# Kamera (CAPTURE_MODE=camera): 0 — noutbukning o'z kamerasi,
# 1 — tashqi USB kamera. Kamera joylashtirilgach BIR MARTA:
#     py camera_calibrate.py      (ekranning 4 burchagini bosing)
CAMERA_INDEX=1

# Dashboard login talab qilsa
# SCADA_USERNAME=
# SCADA_PASSWORD=

# ─────────────────────── KO'RISH (VISION) ───────────────────
# Bo'lish usuli: grid (standart, istalgan dashboardga moslashadi) |
# regions (config.py dagi qo'lda yozilgan koordinatalar) | full (zaxira)
VISION_MODE=grid

# Ekran nechta bo'lakka bo'linib, parallel o'qiladi. Bo'linish ekran
# mazmuniga qarab avtomatik; sekin bo'lak keyingi siklda o'zi ikkiga
# bo'linadi (VISION_MAX_TILES gacha).
VISION_TILES=4
VISION_MAX_TILES=6

# AI xulosasi har nechta o'qishda bir marta (o'qishni sekinlashtirmasligi uchun)
ADVISOR_EVERY_N_READINGS=2

# ⚠️ Bularni PASAYTIRMANG — raqamlar o'qilmay qolib, model
# ularni to'qib chiqara boshlaydi. Batafsil: README, 9-bo'lim.
IMAGE_MAX_WIDTH=960
IMAGE_JPEG_QUALITY=80
VISION_MAX_TOKENS=3000
